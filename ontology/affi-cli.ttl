# ============================================================================
# BENCH NOUN — surface `affi bench <verb>`.
# ============================================================================

# RESERVED, NOT SHIPPED. `receipt-throughput`, `variance`, and `profile` are
# dispatched under the `receipt` noun today; regrouping them under `bench` is a
# deliberate future CLI change (ROADMAP P2-7), not a description of the current
# binary. This noun is therefore declared without verbs: the registry parity
# test compares (verb, noun) pairs, so claiming them here would assert a
# surface that does not exist.
affi:BenchNoun a cnv:Noun ;
    cnv:hasNounName "bench" ;
    cnv:nounAbout "RESERVED for a future regrouping of throughput, variance, and profiling benchmarks" ;
    rdfs:comment "Reserved. Today these verbs ship as affi receipt <receipt-throughput|variance|profile>"@en .

# --- Verb: receipt-throughput -----------------------------------------------
affi:ReceiptThroughputVerb a cnv:Verb ;
    cnv:hasVerbName "receipt-throughput" ;
    cnv:verbAbout "Measure end-to-end latency of the emit -> assemble -> verify pipeline" ;
    cnv:belongsToNoun affi:ReceiptNoun ;
    cnv:returnType "()" ;
    cnv:hasArgument affi:BenchIterationsArg ;
    cnv:hasArguments ( affi:BenchIterationsArg ) .

# --- Verb: variance ---------------------------------------------------------
affi:VarianceVerb a cnv:Verb ;
    cnv:hasVerbName "variance" ;
    cnv:verbAbout "Measure control-flow surprise (anomaly score) and its computation cost" ;
    cnv:belongsToNoun affi:ReceiptNoun ;
    cnv:returnType "()" ;
    cnv:hasArgument affi:BenchReceiptArg ;
    cnv:hasArgument affi:BenchIterationsArg ;
    cnv:hasArguments ( affi:BenchReceiptArg affi:BenchIterationsArg ) .

