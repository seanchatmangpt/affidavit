@@ -31,3 +38,10 @@ pub fn maybe_hex_range<T>(min: T, max: T) -> impl Fn(&str) -> Result<T, String>
     <T as FromStr>::Err: std::fmt::Display,
 {
-    move |s| clap_num::maybe_hex_range(s, min, max)
+    move |s| {
+        if min > max {
