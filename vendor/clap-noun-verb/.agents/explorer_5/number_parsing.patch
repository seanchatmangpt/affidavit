@@ -6,7 +6,14 @@ pub fn decimal_range<T>(min: T, max: T) -> impl Fn(&str) -> Result<T, String>
 where
     T: FromStr + Copy + Ord + std::fmt::Display,
     <T as FromStr>::Err: std::fmt::Display,
 {
