{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatmangpt.github.io/affidavit/sa2a-diataxis-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "base_sha",
    "graph_digest",
    "authority_digest",
    "verifier_digest",
    "standing",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "affidavit/sa2a-diataxis-receipt/v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "minLength": 7
    },
    "graph_digest": {
      "type": "string",
      "minLength": 16
    },
    "authority_digest": {
      "type": "string",
      "minLength": 16
    },
    "verifier_digest": {
      "type": "string",
      "minLength": 16
    },
    "standing": {
      "enum": [
        "?",
        "PARTIAL",
        "ALIVE",
        "BUILD_BROKEN",
        "UNSUPPORTED"
      ]
    },
    "previous_receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 16
    }
  }
}
